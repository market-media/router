RewriteEngine On
Options -Indexes

# Configure HTTPS and a fixed canonical hostname in the server virtual host.
# Do not build redirect destinations from untrusted Host/Forwarded headers.

# ROUTER URL Rewrite
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteCond %{SCRIPT_FILENAME} !-d
RewriteRule ^(.*)$ index.php?route=/$1 [L,QSA]
